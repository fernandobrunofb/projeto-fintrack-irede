<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane fx:id="raiz"
            stylesheets="@estilo.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fintrack.controller.TelaPrincipalController">

    <top>
        <HBox styleClass="cabecalho" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="FinTrack" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Transações" styleClass="botao-nav" onAction="#mostrarTransacoes"/>
            <Button text="Relatório" styleClass="botao-nav" onAction="#mostrarRelatorio"/>
        </HBox>
    </top>

    <center>
        <BorderPane fx:id="painelTransacoes">
            <center>
                <TableView fx:id="tabelaTransacoes">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colunaData" text="Data" prefWidth="120"/>
                        <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="300"/>
                        <TableColumn fx:id="colunaValor" text="Valor" prefWidth="150"/>
                        <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma transação cadastrada."/>
                    </placeholder>
                </TableView>
            </center>
            <bottom>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Button fx:id="botaoRemover" text="Remover" onAction="#removerTransacao"/>
                    <Button fx:id="botaoEditar" text="Editar" onAction="#editarTransacao"/>
                    <Button text="Nova transação" styleClass="botao-primario" onAction="#abrirNovaTransacao"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>